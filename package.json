{
  "name": "match-stats-service",
  "version": "1.0.0",
  "private": true,
  "description": "Post-match stat aggregation service (Express + TypeScript + Prisma/SQLite)",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "db:migrate": "prisma migrate deploy",
    "dev": "npm run generate && npm run db:migrate && tsx watch src/server.ts",
    "start": "prisma migrate deploy && node dist/src/server.js",
    "typecheck": "npm run generate && tsc --noEmit -p tsconfig.json",
    "test": "npm run generate && vitest run",
    "verify": "tsx scripts/verify-test-cases.ts",
    "loadtest": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "better-sqlite3": "12.11.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
