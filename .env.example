# HTTP
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# SQLite database file (relative paths are resolved from the project root)
DATABASE_URL=file:./data/stats.db
# FULL = fsync every commit (power-loss safe). NORMAL = faster, crash-safe but not power-loss safe.
SQLITE_SYNCHRONOUS=FULL

# Write pipeline (group commit). See DECISIONS.md -> "Concurrency model".
WRITE_BATCH_MAX_SIZE=200
WRITE_QUEUE_MAX_PENDING=10000

# Request limits
PLAYER_STATS_MAX_IDS=100
LEADERBOARD_MAX_LIMIT=100
LEADERBOARD_DEFAULT_LIMIT=10
